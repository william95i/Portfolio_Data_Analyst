	column Year = YEAR('hospital_db encounters'[Start])
		formatString: 0
		lineageTag: 1aee68fc-607f-454b-b3d8-497fca6cb350
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Indicateur 1 si la visite dure plus de 24 heures, 0 sinon. Les dates manquantes donnent une valeur vide.
	column 'Over 24 h' =
			VAR Debut = 'hospital_db encounters'[Start]
			VAR Fin = 'hospital_db encounters'[Stop]
			RETURN
			IF(
			    ISBLANK(Debut) || ISBLANK(Fin),
			    BLANK(),
			    IF(DATEDIFF(Debut, Fin, SECOND) > 86400, 1, 0)
			)
		dataType: int64
		formatString: 0
		lineageTag: 98c62e3e-6130-434f-ac4b-319746713edd
		summarizeBy: sum

	column 'Age at visit' =
			
			VAR BirthDate = RELATED('hospital_db patients'[BIRTHDATE])
			VAR VisitDate = 'hospital_db encounters'[Start]
			RETURN
			    IF(
			        ISBLANK(BirthDate) || ISBLANK(VisitDate) || VisitDate < BirthDate,
			        BLANK(),
			        YEAR(VisitDate) - YEAR(BirthDate)
			            - IF(
			                MONTH(VisitDate) * 100 + DAY(VisitDate)
			                    < MONTH(BirthDate) * 100 + DAY(BirthDate),
			                1,
			                0
			            )
			    )
		formatString: 0
		lineageTag: f416c41e-2bdc-4601-92e5-03091bd75ee4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Age group at visit' =
			
			VAR Age = 'hospital_db encounters'[Age at visit]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Age), BLANK(),
			        Age < 35, "19–34 years",
			        Age < 50, "35–49 years",
			        Age < 65, "50–64 years",
			        Age < 80, "65–79 years",
			        "80+ years"
			    )
		lineageTag: d8011795-d545-47a4-aead-8886afbf475a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'hospital_db encounters' = m
		mode: import
		source =
				let
				    Source = MySQL.Database("localhost:3307", "hospital_db", [ReturnSingleDatabase=true]),
				    hospital_db_encounters = Source{[Schema="hospital_db",Item="encounters"]}[Data]
				in
				    hospital_db_encounters

	annotation PBI_ResultType = Table

